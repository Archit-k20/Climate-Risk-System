{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "VITE_APP_MODE=demo npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/upload",
      "destination": "/index.html"
    },
    {
      "source": "/risk-map",
      "destination": "/index.html"
    },
    {
      "source": "/simulator",
      "destination": "/index.html"
    },
    {
      "source": "/reports",
      "destination": "/index.html"
    },
    {
      "source": "/settings",
      "destination": "/index.html"
    }
  ],
  "installCommand": "npm --prefix frontend ci",
  "trailingSlash": false
}
